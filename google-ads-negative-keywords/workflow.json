      "id": "aggregate-keywords",
      "name": "تجميع الكلمات",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [
        340,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://googleads.googleapis.com/v18/customers/{{ $('الإعدادات (Config)').item.json.customerId }}/googleAds:searchStream",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleOAuth2Api",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "developer-token",
              "value": "={{ $('الإعدادات (Config)').item.json.developerToken }}"
            },
            {
              "name": "login-customer-id",
              "value": "={{ $('الإعدادات (Config)').item.json.loginCustomerId }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"query\": \"SELECT search_term_view.search_term, campaign.id, campaign.name, ad_group.id, metrics.clicks, metrics.cost_micros FROM search_term_view WHERE segments.date DURING {{ $('الإعدادات (Config)').item.json.dateRange }} AND metrics.clicks >= {{ $('الإعدادات (Config)').item.json.minClicks }}\"\n}",
        "options": {}
      },
      "id": "get-search-terms",
      "name": "جلب Search Terms",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        560,
        300
      ],
      "credentials": {
        "googleOAuth2Api": {
          "id": "REPLACE_GADS_OAUTH_CRED_ID",
          "name": "Google Ads OAuth2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// ===== مطابقة السيرش تيرم مع قاعدة الكلمات وبناء عمليات الاستبعاد =====\nconst cfg = $('الإعدادات (Config)').first().json;\nconst customerId = String(cfg.customerId);\nconst matchMode = (cfg.matchMode || 'contains').toLowerCase();      // contains | exact\nconst negateMode = (cfg.negateMode || 'searchTerm').toLowerCase();  // searchTerm | keyword\nconst negMatchType = (cfg.negativeMatchType || 'EXACT').toUpperCase();\n\n// --- 1) قائمة الكلمات الممنوعة من الشيت ---\nconst kwAgg = $('تجميع الكلمات').first().json.data || [];\nconst bannedWords = [];\nfor (const row of kwAgg) {\n  // ياخد أول عمود مهما كان اسمه (keyword / كلمة / word ...)\n  const firstVal = Object.values(row).find(v => v !== null && String(v).trim() !== '');\n  if (firstVal) bannedWords.push(String(firstVal).trim().toLowerCase());\n}\nconst uniqueBanned = [...new Set(bannedWords)].filter(Boolean);\n\n// --- 2) نتائج searchStream (بترجع Array من الـ batches) ---\nconst raw = $input.all().map(i => i.json);\nconst results = [];\nfor (const batch of raw) {\n  if (Array.isArray(batch?.results)) results.push(...batch.results);\n  else if (Array.isArray(batch)) {\n    for (const b of batch) if (Array.isArray(b?.results)) results.push(...b.results);\n  }\n}\n\n// --- 3) المطابقة ---\nconst norm = (s) => String(s || '').trim().toLowerCase();\nconst isMatch = (term, word) =>\n  matchMode === 'exact' ? term === word : term.includes(word);\n\nconst seen = new Set();      // منع التكرار\nconst operations = [];\nconst report = [];\n\nfor (const r of results) {\n  const term = norm(r?.searchTermView?.searchTerm);\n  if (!term) continue;\n  const campaignId = r?.campaign?.id;\n  const campaignName = r?.campaign?.name || '';\n  if (!campaignId) continue;\n\n  const hit = uniqueBanned.find(w => isMatch(term, w));\n  if (!hit) continue;\n\n  // النص اللي هيتضاف كـ negative\n  const negText = negateMode === 'keyword' ? hit : term;\n  const dedupeKey = `${campaignId}::${negText}`;\n  if (seen.has(dedupeKey)) continue;\n  seen.add(dedupeKey);\n\n  operations.push({\n    create: {\n      campaign: `customers/${customerId}/campaigns/${campaignId}`,\n      negative: true,\n      keyword: { text: negText, matchType: negMatchType }\n    }\n  });\n\n  report.push({\n    searchTerm: term,\n    matchedWord: hit,\n    negativeAdded: negText,\n    matchType: negMatchType,\n    campaignId: String(campaignId),\n    campaignName,\n    clicks: Number(r?.metrics?.clicks || 0),\n    cost: Number(r?.metrics?.costMicros || 0) / 1e6,\n    date: new Date().toISOString()\n  });\n}\n\nreturn [{\n  json: {\n    customerId,\n    bannedWordsCount: uniqueBanned.length,\n    searchTermsScanned: results.length,\n    matchesFound: operations.length,\n    operations,\n    report\n  }\n}];\n"
      },
      "id": "match-build",
      "name": "المطابقة وبناء العمليات",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
